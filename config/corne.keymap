// ZMK includes

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

// Layer indices. COLEMAK must sit directly above BASE so that, while it is
// toggled on, LOWER/RAISE/CONFIG still take priority over it.
#define BASE 0
#define COLEMAK 1
#define LOWER 2
#define RAISE 3
#define CONFIG 4

/*
 * Blue (clicky) switches chatter more than the 5ms ZMK default debounce
 * accounts for, causing random double key presses. Raise both press and
 * release debounce to filter that out. (Placed here, not in
 * nice_nano_v2.overlay, because &kscan0 is only defined once the shield's
 * corne.dtsi has been merged in, which happens before the keymap overlay
 * is applied but after the board overlay.)
 */
&kscan0 {
    debounce-press-ms = <10>;
    debounce-release-ms = <10>;
};

/*
 * Same ordering gotcha as &kscan0 above: led_strip is defined by the
 * shield's boards/nice_nano_v2.overlay, merged in after the board overlay
 * but before this keymap overlay, so the override has to live here.
 * Corrects the shield's default chain-length (10) to this build's actual
 * LED count (21: back-edge underglow + under-switch).
 */
#define LED_COUNT 21

&led_strip {
    chain-length = <LED_COUNT>;
};

/*
 * Route the underglow through the BT profile indicator (rgb_layer_color
 * module), which lights the active profile's key LED on top of it. LED
 * indices are set in corne.conf (RGB_BT_PROFILE_INDICATOR_LED_<n>).
 */
/ {
    indicator_strip: indicator_strip {
        compatible = "gpmontt,led-strip-indicator";
        led-strip = <&led_strip>;
        chain-length = <LED_COUNT>;
    };

    chosen {
        zmk,underglow = &indicator_strip;
    };
};

/ {
    macros {
        lower_layer: lower_layer {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&lt LOWER SPACE>,
                <&macro_tap>,
                <&rgb_ug RGB_ON &rgb_ug RGB_COLOR_HSB(0,100,49)>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&lt LOWER SPACE>,
                <&macro_tap>,
                <&rgb_ug RGB_OFF>;

            label = "LOWER_LAYER";
        };

        raise_layer: raise_layer {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&mo RAISE>,
                <&macro_tap>,
                <&rgb_ug RGB_ON &rgb_ug RGB_COLOR_HSB(300,51,43)>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mo RAISE>,
                <&macro_tap>,
                <&rgb_ug RGB_OFF>;

            label = "RAISE_LAYER";
        };
    };

    // Combos (press both keys together; positions are physical, so they
    // work the same in QWERTY and Colemak-DH):
    //   E+R = {    D+F = [    C+V = (    |    U+I = }    J+K = ]    M+, = )
    //   TAB+T = reset left half          |    Y+BSPC = reset right half
    combos {
        compatible = "zmk,combos";

        L_Brace {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <4 3>;
        };

        L_Brackets {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <16 15>;
        };

        L_Parenthesis {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <28 27>;
        };

        R_Brace {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <7 8>;
        };

        R_Brackets {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <20 19>;
        };

        R_Parenthesis {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <32 31>;
        };

        reset_left {
            bindings = <&sys_reset>;
            key-positions = <0 5>;
        };

        reset_right {
            bindings = <&sys_reset>;
            key-positions = <6 11>;
        };
    };

    behaviors {
        tp: tap_preferred {
            compatible = "zmk,behavior-hold-tap";
            label = "TAP_PREFERRED";
            bindings = <&none>, <&none>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U  |  I  |  O  |  P  | BSPC |
            // | SHFT |  A  |  S  |  D  |  F  |  G  |   |  H  |  J  |  K  |  L  |  ;  |'/SFT |
            // | RCTL |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M  |  ,  |  .  |  /  |`/CFG |
            //                    | ALT |SPC/L|=/RSE|   |ENT/R|SPC/L| GUI |
            // hold: SFT = right shift, CFG = config layer, L = lower layer, R/RSE = raise layer

            bindings = <
&kp TAB     &kp Q  &kp W  &kp E         &kp R        &kp T          &kp Y        &kp U        &kp I      &kp O    &kp P     &kp BACKSPACE
&kp LSHIFT  &kp A  &kp S  &kp D         &kp F        &kp G          &kp H        &kp J        &kp K      &kp L    &kp SEMI  &mt RSHIFT APOS
&kp RCTRL   &kp Z  &kp X  &kp C         &kp V        &kp B          &kp N        &kp M        &kp COMMA  &kp DOT  &kp FSLH  &lt CONFIG GRAVE
                          &kp LEFT_ALT  &lt LOWER SPACE  &lt RAISE EQUAL    &lt RAISE ENTER  &lt LOWER SPACE  &kp LGUI
            >;
        };

        colemak_dh_layer {
            // Toggled on/off with &tog COLEMAK on the config layer. Only the
            // letter block changes; blank keys fall through to the default layer.
            // -----------------------------------------------------------------------------------------
            // |      |  Q  |  W  |  F  |  P  |  B  |   |  J  |  L  |  U  |  Y  |  ;  |      |
            // |      |  A  |  R  |  S  |  T  |  G  |   |  M  |  N  |  E  |  I  |  O  |      |
            // |      |  Z  |  X  |  C  |  D  |  V  |   |  K  |  H  |  ,  |  .  |  /  |      |
            //                    |     |     |     |   |     |     |     |

            bindings = <
&trans  &kp Q  &kp W  &kp F   &kp P   &kp B     &kp J   &kp L   &kp U      &kp Y    &kp SEMI  &trans
&trans  &kp A  &kp R  &kp S   &kp T   &kp G     &kp M   &kp N   &kp E      &kp I    &kp O     &trans
&trans  &kp Z  &kp X  &kp C   &kp D   &kp V     &kp K   &kp H   &kp COMMA  &kp DOT  &kp FSLH  &trans
                      &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  ESC |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | DEL  |
            // |      |     |PSCRN| INS |  x  |     |   | LFT | DWN |  UP | RGT |     | HOME |
            // |      |     |     |     |     |     |   |     |     |     |     |     | END  |
            //                    |     |     |     |   | ENT |     |     |
            // blank = transparent, x = none

            bindings = <
&kp ESC  &kp N1  &kp N2           &kp N3   &kp N4  &kp N5    &kp N6     &kp N7    &kp N8  &kp N9     &kp N0  &kp DELETE
&trans   &trans  &kp PRINTSCREEN  &kp INS  &none   &trans    &kp LEFT   &kp DOWN  &kp UP  &kp RIGHT  &trans  &kp HOME
&trans   &trans  &trans           &trans   &trans  &trans    &trans     &trans    &trans  &trans     &trans  &kp END
                                  &trans   &trans  &trans    &kp ENTER  &trans    &trans
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |   `  |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  |      |
            // |      |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // |      |     |     |     |     |     |   |  _  |  +  |  {  |  }  |  |  |  ~   |
            //                    |     |     |     |   |     |     |     |
            // blank = transparent

            bindings = <
&kp GRAVE  &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT    &kp CARET  &kp AMPS   &kp ASTERISK  &kp LPAR  &kp RPAR  &trans
&trans     &trans    &trans  &trans    &trans    &trans       &kp MINUS  &kp EQUAL  &kp LBKT      &kp RBKT  &kp BSLH  &kp GRAVE
&trans     &trans    &trans  &trans    &trans    &trans       &kp UNDER  &kp PLUS   &kp LBRC      &kp RBRC  &kp PIPE  &kp TILDE
                             &trans    &trans    &trans       &trans     &trans     &trans
            >;
        };

        config {
            // -----------------------------------------------------------------------------------------
            // |      | BT0 | BT1 | BT2 |OUTTG|STUDI|   |STUDI| F12 |  F7 |  F8 |  F9 |      |
            // |      |BTCLR|CLMAK|BTCLA|RGBTG|RGBEF|   |     | F11 |  F4 |  F5 |  F6 |      |
            // | EXTPW|     |     |     |BRT- |BRT+ |   |     | F10 |  F1 |  F2 |  F3 |      |
            //                    |     |     |     |   |     |VOL- |VOL+ |
            // BT0-2 = select BT profile, BTCLR = clear current profile, BTCLA = clear all profiles,
            // OUTTG = toggle USB/BLE output,
            // CLMAK = toggle Colemak-DH, STUDI = ZMK Studio unlock, RGBTG = underglow on/off,
            // RGBEF = next underglow effect, BRT-/+ = underglow brightness,
            // EXTPW = toggle LED power, blank = transparent, x = none

            bindings = <
&trans             &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2    &out OUT_TOG     &studio_unlock   &studio_unlock  &kp F12  &kp F7  &kp F8  &kp F9  &trans
&trans             &bt BT_CLR    &tog COLEMAK  &bt BT_CLR_ALL  &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &trans          &kp F11  &kp F4  &kp F5  &kp F6  &trans
&ext_power EP_TOG  &trans        &trans        &trans          &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &trans          &kp F10  &kp F1  &kp F2  &kp F3  &trans
                                               &trans          &trans           &trans           &trans          &kp C_VOLUME_DOWN  &kp C_VOLUME_UP
            >;
        };
    };
};
